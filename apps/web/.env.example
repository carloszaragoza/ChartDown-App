# Copy to .env.local, or run `npx vercel env pull` in apps/web.
# Values for each environment are in Vercel; see docs/infrastructure.md.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# The project ref (the first part of its supabase.co address): keeps the session cookie's name
# when NEXT_PUBLIC_SUPABASE_URL is a custom domain such as https://auth.chartdown.app (T-2818).
NEXT_PUBLIC_SUPABASE_PROJECT_REF=
